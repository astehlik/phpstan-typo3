{
	"name": "saschaegerer/phpstan-typo3",
	"description": "TYPO3 CMS class reflection extension for PHPStan",
	"keywords": [
		"static analysis"
	],
	"license": [
		"MIT"
	],
	"type": "phpstan-extension",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": "^8.2",
		"ext-simplexml": "*",
		"phpstan/phpstan": "^2.1",
		"typo3/cms-core": "^12.4",
		"typo3/cms-extbase": "^12.4",
		"bnf/phpstan-psr-container": "^1.0",
		"ssch/typo3-debug-dump-pass": "^0.0.2"
	},
	"require-dev": {
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"psr-4": {
			"SaschaEgerer\\PhpstanTypo3\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SaschaEgerer\\PhpstanTypo3\\Tests\\": "tests/"
		},
		"files": [
			"tests/Unit/Type/data/custom-query-type.php",
			"tests/Unit/Type/data/repository-model-resolver.php",
			"tests/Unit/Type/data/repository-stub-files.php",
			"tests/Unit/Type/data/query-result-to-array.php"
		]
	},
	"extra": {
		"phpstan": {
			"includes": [
				"extension.neon"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"scripts": {
		"test": [
			"@test:phpunit",
			"@test:phpstan",
			"@test:php-lint"
		],
		"test:phpunit": "phpunit --colors=always tests/",
		"test:phpstan": "phpstan --memory-limit=2G",
		"test:php-lint": "parallel-lint src tests"
	}
}
